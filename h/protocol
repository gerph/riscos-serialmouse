#ifndef SERMOUSE2_PROTOCOL_H
#define SERMOUSE2_PROTOCOL_H

#include <stdint.h>

/*******************************************************************
 Function:      protocol_reset
 Description:   Resets the report state machine and accumulated mouse data.
 Parameters:    none
 Returns:       none
 ******************************************************************/
