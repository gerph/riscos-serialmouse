/*******************************************************************
 * File:        module
 * Purpose:     Module lifecycle for the SerMouse2 serial mouse driver.
 * Author:      Gerph
 ******************************************************************/

#include <stdlib.h>

#include "kernel.h"
#include "pointer.h"
#include "serial.h"

/*******************************************************************
 Function:      Mod_Init
 Description:   Claims PointerV and enables the driver when its type is
                already selected.
 Parameters:    tail = module command tail
                podule_base = podule base, or zero
                pw = module private word
 Returns:       NULL on success, otherwise an OS error
 ******************************************************************/
_kernel_oserror *Mod_Init(const char *tail, int podule_base, void *pw)
{
    _kernel_oserror *err;

    (void)tail;
    (void)podule_base;

    err = pointer_claim(pw);
    if (err != NULL)
        return err;

    err = pointer_enable_selected(pw);
    if (err != NULL)
        pointer_release(pw);

    return err;
}

/*******************************************************************
 Function:      Mod_Final
 Description:   Disables the serial input and releases PointerV.
 Parameters:    fatal = fatality indicator
                podule_base = podule base, or zero
                pw = module private word
 Returns:       NULL; cleanup is safe after a partial initialisation
 ******************************************************************/
_kernel_oserror *Mod_Final(int fatal, int podule_base, void *pw)
{
    (void)fatal;
    (void)podule_base;

    serial_disable(pw);
    pointer_release(pw);
    return NULL;
}
